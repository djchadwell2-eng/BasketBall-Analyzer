# Gemini — get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth & quota
# Comma-separated emails that bypass the monthly limit (your own account)
ADMIN_EMAILS=
# Analyses allowed per account per calendar month (default 5)
MONTHLY_ANALYSIS_LIMIT=5
